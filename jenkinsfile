pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo "Started building the Project.........."
                sleep 5
                echo "Build complete."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying the Project.........."
                sleep 5
                echo "Deployment complete."
            }
        }

        stage('Test') {
            steps {
                echo "Testing the Project.........."
            }
        }

        stage('Release') {
            steps {
                echo "Releasing the Project.........."
            }
        }

    }
}
